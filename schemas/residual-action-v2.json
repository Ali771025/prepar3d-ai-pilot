{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.p3d-ai/schemas/residual-action-v2.json",
  "title": "P3D Residual Action v2",
  "type": "object",
  "required": ["action", "stage", "step_id", "reset_id", "uncertainty"],
  "properties": {
    "action": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": -1, "maximum": 1}},
    "stage": {"enum": ["airwork", "pattern", "approach", "full"]},
    "step_id": {"type": "integer", "minimum": 0},
    "reset_id": {"type": "integer", "minimum": 0},
    "uncertainty": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": false
}

