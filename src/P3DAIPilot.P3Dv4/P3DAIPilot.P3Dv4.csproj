<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <P3DSdkRoot Condition="'$(P3DSdkRoot)' == ''">$(P3D_SDK_ROOT)</P3DSdkRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\P3DAIPilot.Core\P3DAIPilot.Core.csproj" />
    <PackageReference Include="FSUIPCClientDLL" Version="3.3.16" />
    <Reference Include="LockheedMartin.Prepar3D.SimConnect">
      <HintPath>$(P3DSdkRoot)\lib\SimConnect\managed\LockheedMartin.Prepar3D.SimConnect.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\config\appsettings.json" Link="config\appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\config\aircraft\*.json" Link="config\aircraft\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Target Name="ValidateP3DSdk" BeforeTargets="ResolveReferences" Condition="!Exists('$(P3DSdkRoot)\lib\SimConnect\managed\LockheedMartin.Prepar3D.SimConnect.dll')">
    <Error Text="P3D v4 SimConnect DLL not found. Set P3D_SDK_ROOT to the Prepar3D v4 SDK root." />
  </Target>
</Project>
